# Normalise line endings so the repo is consistent across platforms.
* text=auto eol=lf

# Binary assets must never be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Generated CSVs are data, not text to diff aggressively.
*.csv text eol=lf

# Shell scripts must keep LF for the Linux container.
*.sh text eol=lf
Dockerfile text eol=lf
