# ARGUS ML — environment variables (example only; never commit real values)
#
# Copy to `.env` for local work. Every variable below was read from the code
# (grep os.environ / env.get across services/ml and apps/web) — none are
# invented. See docs/DEPLOYMENT_CHECKLIST.md for what breaks when one is
# missing.

# ---------------------------------------------------------------------------
# API (services/ml)
# ---------------------------------------------------------------------------
# Postgres DSN. Unset => the service runs on the in-memory stub data layer and
# /health reports "stub (UNCONFIRMED demo)". Set-but-unreachable => /health
# reports "degraded" / "postgres (UNREACHABLE)" and routes keep serving.
DATABASE_URL=postgresql://user:pass@host:5432/argus

# Optional Redis: shared rate-limit window + response cache. Unset => in-process
# limiter (per replica) and no cache. A dead Redis degrades, it never 500s.
REDIS_URL=redis://localhost:6379/0

# --- Authentication (Supabase JWT) -----------------------------------------
# HS256 shared secret. When unset the auth layer fails CLOSED (503).
SUPABASE_JWT_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional audience/issuer enforcement. Enabling these INVALIDATES tokens that
# lack the matching claims, so roll out in staging first.
SUPABASE_JWT_AUD=
SUPABASE_JWT_ISS=

# --- Boot / environment ----------------------------------------------------
# "production" (or unset) means production semantics. Set to development/dev/
# local/test ONLY on a developer machine.
ARGUS_ENV=development
# DANGER: AUTH_DISABLED=true turns JWT verification off and serves a fixed
# "dev" identity. It is refused unless one of the two dev opt-ins below is set.
AUTH_DISABLED=true
ARGUS_ALLOW_AUTH_DISABLED=1

# --- CORS ------------------------------------------------------------------
# Comma-separated allowlist. Outside local/dev the app refuses to start if this
# is unset or wildcard (fail-closed). No "*" when credentials are allowed.
CORS_ORIGINS=http://localhost:3000

# --- Proxy trust (client IP resolution) ------------------------------------
# X-Forwarded-For is honoured ONLY from these peers (comma-separated IPs/CIDRs).
# Empty => every client shares the proxy's single rate-limit bucket.
TRUSTED_PROXIES=127.0.0.1/32,::1/128
# uvicorn --proxy-headers trust list. Never "*".
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Migrations ------------------------------------------------------------
# 1 => the preDeploy migration step exits non-zero on failure (blocks release).
# Unset/0 => migrations are attempted at boot and failures are a loud warning.
MIGRATIONS_FATAL=0
# Bounded connect timeout for migrate.py and the /health probe (seconds).
ARGUS_DB_CONNECT_TIMEOUT=5
ARGUS_HEALTH_DB_TIMEOUT=1.5
# Set to 1 to retry a migration previously recorded as skipped.
# ARGUS_RETRY_SKIPPED=0

# --- Notifications (optional; unset => "not_configured", never faked) ------
RESEND_API_KEY=
RESEND_FROM=
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# ---------------------------------------------------------------------------
# Web (apps/web) — build-time values, baked into the bundle
# ---------------------------------------------------------------------------
# Base URL of the API. If unset in a production build the app renders a red
# configuration banner instead of silently falling back to localhost.
NEXT_PUBLIC_ARGUS_API_URL=http://localhost:8000
# Server-side rewrite target for /api/* (Next.js server mode only).
ARGUS_API_ORIGIN=http://127.0.0.1:8000
